      }
    ],
    [
      "c1",
      "earlier",
      {
        "type": 2,
        "text": "same",
        "serverBubbleId": "server-1",
        "createdAt": "2026-07-10T00:00:01Z"
      }
    ],
    [
      "c1",
      "context-only",
      {
        "type": 2,
        "text": "  \n",
        "relevantFiles": ["README.md"]
      }
    ],
    [
      "c2",
      "other-composer",
      {
