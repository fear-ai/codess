{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codess.local/schema/investigation-v2.json",
  "title": "Codess cited investigation v1",
  "type": "object",
  "required": [
    "format",
    "created_at",
    "processor_id",
    "summary",
    "input_result_hash",
    "input_request_hash",
    "project_snapshots",
    "input_bounds",
    "input_limitations",
    "citations",
    "investigation_hash"
  ],
  "properties": {
    "format": {"const": "codess.investigation/2"},
    "created_at": {"type": "string"},
    "processor_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "input_result_hash": {"type": "string"},
    "input_request_hash": {"type": "string"},
    "project_snapshots": {"type": "array", "items": {"type": "object"}},
    "input_bounds": {"type": "object"},
    "input_limitations": {"type": "array", "items": {"type": "string"}},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_entity_id",
          "observation_id",
          "session_entity_id",
          "project_id",
          "snapshot_id",
          "source_system_key",
          "source_record_locator",
          "event_kind",
          "content_digest",
          "content_complete"
        ],
        "additionalProperties": true
      }
    },
    "investigation_hash": {"type": "string"}
  },
  "additionalProperties": false
}
