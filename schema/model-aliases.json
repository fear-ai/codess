{
  "format_id": "codess.model-aliases",
  "format_version": 1,
  "purpose": "Resolves a vendor model string to its API name, family, generation, and strength. Data rather than code so a vendor's new model name does not require a release. A name absent from here is recorded unresolved, never guessed: the harness label is retained verbatim in every case, and only the derived fields are left null.",
  "matching": "Case-folded exact match on the whole string. Not a substring or prefix match -- 'claude' appears inside Cursor's model names as well as Anthropic's, so a token match cannot tell provider from family.",
  "families": {
    "vocabulary": [
      "opus",
      "sonnet",
      "haiku",
      "fable",
      "mython"
    ],
    "reserved": [
      "mythos"
    ],
    "note": "Mythos exists but is not generally available, so it is declared and unobserved. A family outside this list resolves unresolved rather than being accepted as new."
  },
  "sentinels": {
    "<synthetic>": {
      "vendor": "Claude",
      "meaning": "Claude's own placeholder where no model answered; observed on 62 real records. Recorded as a sentinel rather than parsed, so it never yields a family or generation.",
      "resolves": false
    },
    "default": {
      "vendor": "Cursor",
      "meaning": "Cursor records the absence of an explicit model choice. Different from an unknown model, and not resolvable to one.",
      "resolves": false
    }
  },
