{
  "decoder_version": "0.2",
  "direction": "source_to_common",
  "harness_name": "codex",
  "hazards": [
    "archived-directory-is-not-completion",
    "no-stable-parent-session-id",
    "call-status-is-vendor-status"
  ],
  "mapping_id": "codess.codex",
  "rules": [
    {
      "id": "codex.message",
      "operation": "from",
      "retention": "core",
      "source": "response_item.message",
      "target": "events"
    },
    {
      "id": "codex.context-injection",
      "operation": "from",
      "retention": "core",
      "source": "response_item.message[role=developer|system]",
      "target": "events.message.context"
    },
    {
      "id": "codex.reasoning-summary",
      "operation": "from_each",
      "retention": "core",
      "source": "response_item.reasoning.summary[].text",
      "target": "events.message.reasoning_summary"
    },
    {
      "id": "codex.tool-call",
      "operation": "from_any",
      "retention": "specialized",
      "source": "response_item.function_call|custom_tool_call|web_search_call",
      "target": "tool_invocations"
    },
    {
      "id": "codex.tool-result",
      "operation": "from_any",
      "retention": "specialized",
      "source": "response_item.function_call_output|custom_tool_call_output",
      "target": "tool_results"
    },
    {
      "id": "codex.abort",
      "operation": "from",
      "retention": "core",
      "source": "event_msg.turn_aborted",
      "target": "events.lifecycle.abort"
    },
    {
      "id": "codex.task-lifecycle",
      "operation": "from_any",
      "retention": "core",
      "source": "event_msg.task_started|task_complete",
      "target": "events.lifecycle"
    },
    {
      "id": "codex.compaction",
      "operation": "from_each",
      "retention": "core",
      "source": "compacted.payload.replacement_history[].compaction",
      "target": "events.context.compact"
    },
    {
      "id": "codex.session-meta",
      "operation": "from",
      "retention": "extension",
      "source": "session_meta.payload",
      "target": "sessions"
    },
    {
      "id": "codex.configuration",
      "operation": "from_any",
      "retention": "specialized",
      "source": "turn_context.payload|event_msg.thread_settings_applied.payload.thread_settings",
      "target": "model_params+model_turns.model_param_id"
    },
    {
      "id": "codex.turn-identity",
      "operation": "from",
      "retention": "core",
      "source": "turn_context.payload.turn_id",
      "target": "model_turns.source_turn_id"
    },
    {
      "id": "codex.archive-location",
      "operation": "from",
      "retention": "extension",
      "source": "session source root",
      "target": "sessions.archive_state+sessions.archive_source"
    }
  ],
  "source_system_key": "openai.codex",
  "storage_formats": [
    "codex-jsonl"
  ],
  "vendor": "openai"
}
