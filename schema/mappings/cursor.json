{
  "decoder_version": "0.2",
  "direction": "source_to_common",
  "harness_name": "cursor",
  "hazards": [
    "live-sqlite-requires-consistent-read",
    "global-db-must-be-project-scoped",
    "renamed-or-remote-workspace-requires-approved-source-link",
    "bubble-role-is-not-actor",
    "repeated-server-bubble-copies",
    "whitespace-only-assistant-envelopes-are-not-messages",
    "toolResults-may-be-present-but-empty",
    "default-model-selection-is-not-an-exact-model-name",
    "agent-kv-blob-holds-several-encodings-under-one-key-space",
    "agent-kv-request-may-name-no-decoded-session"
  ],
  "mapping_id": "codess.cursor-composer",
  "rules": [
    {
      "id": "cursor.bubble",
      "operation": "from_each",
      "retention": "core",
      "source": "cursorDiskKV.bubbleId:*",
      "target": "events"
    },
    {
      "id": "cursor.reasoning",
      "operation": "from_each",
      "retention": "core",
      "source": "cursorDiskKV.bubbleId:*.thinking",
      "target": "events"
    },
    {
      "id": "cursor.tool-former-invocation",
      "operation": "from",
      "retention": "specialized",
      "source": "bubble.toolFormerData",
      "target": "tool_invocations"
    },
    {
      "id": "cursor.tool-former-result",
      "operation": "from",
      "retention": "specialized",
      "source": "bubble.toolFormerData.result,status",
      "target": "tool_results"
    },
    {
      "id": "cursor.permission-decision",
      "operation": "from",
      "retention": "specialized",
      "source": "bubble.toolFormerData.userDecision",
      "target": "tool_invocations.source_status+tool_invocations.normalized_status"
    },
    {
      "id": "cursor.tool-result-legacy",
      "operation": "from_each",
      "retention": "specialized",
      "source": "bubble.toolResults[]",
      "target": "tool_results"
    },
    {
      "id": "cursor.model-selection",
      "operation": "from",
      "retention": "specialized",
      "source": "bubble.modelInfo.modelName",
      "target": "model_turns.model_param_id"
    },
    {
      "id": "cursor.context-window-observation",
      "operation": "from",
      "retention": "extension",
      "source": "bubble.contextWindowStatusAtCreation",
      "target": "events.metadata"
    },
    {
      "id": "cursor.compaction-summary",
      "operation": "from",
      "retention": "core",
      "source": "bubble.conversationSummary",
      "target": "events.context.compact"
    },
    {
      "id": "cursor.request-context",
      "operation": "from_each",
      "retention": "core",
      "source": "cursorDiskKV.messageRequestContext:*",
      "target": "events.context.inject"
    },
    {
      "id": "cursor.header",
      "operation": "from",
      "retention": "extension",
      "source": "composerHeaders",
      "target": "sessions"
    },
    {
      "id": "cursor.archive",
      "operation": "from",
      "retention": "core",
      "source": "composerHeaders.isArchived",
      "target": "sessions.archive_state"
    },
    {
      "id": "cursor.subagent",
      "operation": "from",
      "retention": "core",
      "source": "composerHeaders.isSubagent",
      "target": "sessions.session_relation_kind"
    },
    {
      "id": "cursor.agent-system-prompt",
      "operation": "from_each",
      "retention": "core",
      "source": "cursorDiskKV.agentKv:blob:*.content[]",
      "target": "events"
    },
    {
      "id": "cursor.agent-reasoning",
      "operation": "from_each",
      "retention": "core",
      "source": "cursorDiskKV.agentKv:blob:*.content[]",
      "target": "events"
    }
  ],
  "source_system_key": "cursor.composer",
  "storage_formats": [
    "cursor-sqlite"
  ],
  "vendor": "cursor"
}
